{
  "manifest_version": 3,
  "name": "Edward",
  "version": "0.2.0",
  "description": "Edward's hands in this Chrome: he can see your tabs, open pages, read, click and type, and go full screen, using your logins. Everything he does is logged in Edward.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Edward"
  }
}
